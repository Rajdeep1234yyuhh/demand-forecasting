DF_ENV=dev
DF_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DF_OBJECT_STORAGE_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
DF_OBJECT_STORAGE_ACCESS_KEY=
DF_OBJECT_STORAGE_SECRET_KEY=
DF_MLFLOW_TRACKING_URI=http://localhost:5000
